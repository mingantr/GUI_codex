# Configuration de l'intégration Codex CLI
# Renseignez la commande à exécuter pour lancer Codex CLI. Quelques exemples:
# - Avec Node.js / npx installé localement:
#   CODEX_CLI=npx -y @openai/codex
# - Si vous avez un binaire global `codex` dans le PATH:
#   CODEX_CLI=codex
# - Ou un chemin absolu vers un script .bat/.cmd:
#   CODEX_CLI=C:\\Users\\you\\AppData\\Roaming\\npm\\npx.cmd -y @openai/codex

CODEX_CLI=npx -y @openai/codex

# Mode d'appel du backend:
# - exec  : utilise "codex exec" en non interactif (par défaut)
# - stdin : envoie le prompt sur stdin du processus
CODEX_MODE=exec

# Politique d'approbations (facultatif): never | on-request | on-failure | untrusted
# Transmise via -a/--ask-for-approval en mode exec. Si vide, laisse la valeur par défaut.
# L'UI peut aussi définir cette valeur à l'envoi.
CODEX_APPROVALS=

# Forcer le mode sans TUI (ajoute --no-tui en mode exec)
CODEX_NO_TUI=1

# Activer l'exécution autonome (ajoute --full-auto en mode exec)
CODEX_FULL_AUTO=0

# Désactiver sandbox + approvals (dangereux) — ajoute --yolo
CODEX_YOLO=0

# Sélection de profil (ajoute --profile <name>)
CODEX_PROFILE=

# Sortie JSON (ajoute --json)
CODEX_JSON=0

# Sauvegarder le dernier message (-o <path>)
CODEX_OUTPUT=

# Reprendre la dernière exécution (ajoute le sous-commande: exec resume --last)
CODEX_RESUME_LAST=0

# Flags additionnels à passer tels quels en mode exec
# Exemple: --sandbox workspace-write
CODEX_FLAGS=

# Clé API si requise par votre configuration Codex/outil en aval
# OPENAI_API_KEY=
